# =============================================================================
# Ferretería Joel — variables de entorno
# =============================================================================
#
# Este archivo es una PLANTILLA. No contiene ningún secreto real.
#
#   1. Copie este archivo a ".env" en la misma carpeta:
#          cp .env.example .env      (Linux / macOS)
#          copy .env.example .env    (Windows)
#
#   2. Complete los valores marcados como OBLIGATORIO.
#
#   3. Levante el proyecto:
#          docker compose up -d --build
#
# El archivo ".env" está en .gitignore: no se versiona nunca.
#
# Docker Compose lee este mismo archivo para resolver los ${VARIABLE} del
# docker-compose.yml, y la aplicación lo lee al arrancar (busca el archivo en
# su carpeta y en las carpetas padre). Por eso hay dos familias de variables:
#
#   - Las de Docker Compose (MYSQL_*, SMTP_*, HTTP_PUERTO_HOST...) se
#     escriben con nombre plano.
#   - Las de la aplicación (Smtp__Host, UrlProteccion__Clave...) usan doble
#     guion bajo porque así es como ASP.NET Core traduce una variable de
#     entorno a una clave de configuración con secciones.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos MySQL
# -----------------------------------------------------------------------------

# OBLIGATORIO. Contraseña del usuario root de MySQL.
MYSQL_ROOT_PASSWORD=cambie_esta_contrasena

# Nombre de la base de datos.
MYSQL_DATABASE=bdferreteria

# Puerto del host para MySQL (el contenedor escucha siempre en 3306).
MYSQL_PUERTO_HOST=3307


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Puerto del host para Redis (el contenedor escucha siempre en 6379).
REDIS_PUERTO_HOST=6379

# Tiempo de vida de la sesión, en minutos.
REDIS_SESSION_TTL_MINUTES=30

# Tiempo de vida de las entradas de la caché de consultas, en minutos.
# Es el valor por defecto de Redis:CacheTtlMinutes.
REDIS_CACHE_TTL_MINUTES=5


# -----------------------------------------------------------------------------
# Protección de URLs y Data Protection
# -----------------------------------------------------------------------------

# OBLIGATORIO. Clave del protector de URLs firmadas (enlaces de activación).
# Use una cadena larga y aleatoria, por ejemplo la salida de:
#   openssl rand -base64 48
URL_PROTECCION_CLAVE=cambie_esta_clave_por_una_larga_y_aleatoria

# Ruta, dentro del contenedor, del certificado con el que se cifran las claves
# de Data Protection. El certificado lo genera el entrypoint en el volumen
# compartido "proteccion_datos" y debe ser el mismo en las cuatro réplicas.
# Esta variable la usa la aplicación; no hay que cambiarla.
DataProtection__CertificadoRuta=/var/ferreteria/proteccion/proteccion.pfx

# Contraseña del certificado. Está vacío porque el certificado generado por el
# entrypoint no tiene contraseña.
DataProtection__CertificadoContrasena=


# -----------------------------------------------------------------------------
# Envío de correo (SMTP) — opcional
# -----------------------------------------------------------------------------
#
# Si SMTP__Host queda vacío, la aplicación NO envía correos: el enlace de
# activación se escribe en el log del contenedor. Es lo cómodo para el
# laboratorio, pero no lo que se hace en una demostración real.
#
# Si va a usar Gmail:
#   1. Active la verificación en dos pasos.
#   2. Cree una "contraseña de aplicación".
#   3. Rote la clave anterior (la que estuvo publicada en el repositorio)
#      y ponga aquí la nueva.
#
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=cuenta@gmail.com
SMTP_CLAVE=
SMTP_USAR_SSL=true
SMTP_REMITENTE=cuenta@gmail.com
SMTP_REMITENTE_NOMBRE=Ferretería Joel


# -----------------------------------------------------------------------------
# Puertos publicados en el host
# -----------------------------------------------------------------------------

# Puerto donde Nginx escucha (el punto de entrada único de la aplicación).
HTTP_PUERTO_HOST=80


# -----------------------------------------------------------------------------
# Variables que consume directamente la aplicación (formato con doble guion)
# -----------------------------------------------------------------------------
#
# Las siguientes ya las define el docker-compose.yml a partir de los valores
# anteriores. Se listan aquí para poder ejecutar la aplicación fuera de Docker
# (por ejemplo con "dotnet run") usando el mismo archivo .env.
#
# Conexión a MySQL: en Docker el host es "mysql"; en local, "localhost".
# Dentro de los contenedores la define el docker-compose.yml, así que este
# valor solo se usa cuando la aplicación se ejecuta fuera de Docker.
ConnectionStrings__MySqlConnection=Server=localhost;Database=bdferreteria;Uid=root;Pwd=cambie_esta_contrasena;

# Conexión a Redis: en Docker el host es "redis"; en local, "localhost".
Redis__Connection=localhost:6379

Redis__SessionTtlMinutes=30
Redis__CacheTtlMinutes=5

UrlProteccion__Clave=cambie_esta_clave_por_una_larga_y_aleatoria

Smtp__Host=smtp.gmail.com
Smtp__Puerto=587
Smtp__Usuario=cuenta@gmail.com
Smtp__Clave=
Smtp__UsarSsl=true
Smtp__Remitente=cuenta@gmail.com
Smtp__RemitenteNombre=Ferretería Joel
