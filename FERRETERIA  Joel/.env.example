# Archivo de ejemplo. Copie este archivo como ".env" (no versionado) en esta
# misma carpeta para definir variables de entorno sin editar appsettings.json.
# Formato: CLAVE=valor (use "__" para anidar configuración).
# Las variables del sistema ya definidas tienen prioridad sobre este archivo.

# Cadena de conexión a MySQL local.
ConnectionStrings__MySqlConnection=Server=localhost;Database=bdferreteria;Uid=root;Pwd=tu_clave;

# Clave para proteger los tokens de URL (comprobantes y activación de cuentas).
UrlProteccion__Clave=una_clave_larga_para_proteger_los_tokens_de_url

# Servidor SMTP para enviar los enlaces de activación de cuentas.
# Si deja Smtp__Host vacío, el enlace se escribe en el log (modo desarrollo).
Smtp__Host=smtp.tu-proveedor.com
Smtp__Puerto=587
Smtp__Usuario=cuenta@tu-proveedor.com
Smtp__Clave=tu_clave_smtp
Smtp__UsarSsl=true
Smtp__Remitente=no-reply@ferreteriajoel.com
Smtp__RemitenteNombre=Ferretería Joel
