@page
@model FERRETERIA__Joel.Pages.ProductosModel
@{
    ViewData["Title"] = "Productos";
    ViewData["ActiveMenu"] = "Productos";
    string accionFiltro = Model.SoloActivos ? "" : "true";
    string etiquetaFiltro = Model.SoloActivos ? "Mostrar todos" : "Solo activos";
}
@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Catálogo</p>
        <h1>Productos</h1>
        <p class="fj-page-sub">Administración y consulta de productos.</p>
    </section>

    @if (TempData["MensajeError"] != null)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <span>@TempData["MensajeError"]</span>
        </div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="fj-alert fj-alert-success" role="status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    <section class="fj-toolbar fj-toolbar-simple">
        <p class="fj-toolbar-count">
            <strong>@Model.ListProductos.Count</strong>
            @(Model.ListProductos.Count == 1 ? "producto" : "productos") en el catálogo
        </p>

        <div class="fj-toolbar-actions">
            <a class="fj-btn fj-btn-edit"
               asp-route-soloActivos="@accionFiltro">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                @etiquetaFiltro
            </a>

            <a class="fj-btn fj-btn-primary" asp-page="ProductoNuevo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Agregar producto
            </a>
        </div>
    </section>

    <section class="fj-card fj-table-card" aria-label="Listado de productos">
        <div class="fj-table-wrap">
            <table class="fj-table">
                <thead>
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Categoría</th>
                        <th scope="col" class="fj-th-detalle">Detalle</th>
                        <th scope="col" class="fj-td-precio">Precio</th>
                        <th scope="col" class="fj-td-estado">Estado</th>
                        <th scope="col" class="fj-td-acciones">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.ListProductos.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="fj-table-vacio">
                                <div class="fj-empty">
                                    <span class="fj-empty-ico" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                                            <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                                            <line x1="12" y1="22.08" x2="12" y2="12" />
                                        </svg>
                                    </span>

                                    <p>Sin productos registrados</p>
                                    <span>Cuando existan productos en el catálogo, aparecerán aquí.</span>
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model.ListProductos)
                    {
                        <tr>
                            <td class="fj-td-codigo">
                                <span class="fj-codigo">@item.Codigo</span>
                            </td>

                            <td>
                                <span class="fj-nombre">@item.Nombre</span>
                                <span class="fj-nombre-sub">@item.NombreMarca</span>
                            </td>

                            <td class="fj-td-secundario">
                                @{
                                    var categoria = Model.Categorias
                                        .FirstOrDefault(c => c.IdCategoria == item.IdCategoria);
                                }

                                @(categoria?.Nombre ?? "Sin categoría")
                            </td>

                            <td class="fj-td-detalle">
                                <button type="button"
                                        class="fj-btn fj-btn-edit fj-btn-detalle"
                                        data-fj-detalle
                                        data-titulo="Detalle del producto"
                                        data-nombre="@item.Nombre"
                                        data-descripcion="@(item.Descripcion ?? "")"
                                        data-unidad="@item.UnidadMedida"
                                        title="Ver descripción y unidad"
                                        aria-label="Ver descripción y unidad">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                                    <span>Detalles</span>
                                </button>
                            </td>

                            <td class="fj-td-precio">
                                <span class="fj-precio">@item.PrecioVenta.ToString("N2")</span>
                                <span class="fj-currency">Bs</span>
                            </td>

                            <td class="fj-td-estado">
                                <span class="fj-pill" style="--pill: var(@(item.Estado == 1 ? "--success" : "--texto-ter"));">@(item.Estado == 1 ? "Activo" : "Inactivo")</span>
                            </td>

                            <td class="fj-td-acciones">
                                <div class="fj-acciones">

                                    <a class="fj-btn fj-btn-edit fj-btn-icon"
                                       asp-page="ProductoEditar"
                                       asp-route-token="@Model.ObtenerToken(item.IdProducto)"
                                       title="Editar producto"
                                       aria-label="Editar producto">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </a>

                                    <a class="fj-btn fj-btn-edit fj-btn-icon"
                                       asp-page="ProductoHistoricoPrecio"
                                       asp-route-token="@Model.ObtenerToken(item.IdProducto)"
                                       title="Historial de precios"
                                       aria-label="Historial de precios">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                    </a>


                                    @if (item.Estado == 1)
                                    {
                                        <form method="post"
                                              asp-page-handler="Eliminar"
                                              asp-route-idProducto="@item.IdProducto"
                                              class="fj-inline-form"
                                              data-fj-confirm="¿Desea desactivar el producto '@item.Nombre'?">

                                            <button type="submit" class="fj-btn fj-btn-danger fj-btn-icon" title="Desactivar producto" aria-label="Desactivar producto">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <polyline points="3 6 5 6 21 6" />
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                                </svg>
                                            </button>

                                        </form>
                                    }

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </section>

</div>

<partial name="_ConfirmModal" />

@* Modal de detalle: descripción y unidad de medida del producto *@
<div class="fj-modal" id="fjDetalleModal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="fjDetalleTitle">
    <div class="fj-modal-backdrop" data-fj-modal-close aria-hidden="true"></div>
    <div class="fj-modal-wrapper" role="document">
        <div class="fj-modal-dialog">
            <div class="fj-modal-icon fj-modal-icon-info" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
            </div>
            <h2 class="fj-modal-title" id="fjDetalleTitle">Detalle del producto</h2>
            <p class="fj-modal-producto" id="fjDetalleProducto"></p>

            <dl class="fj-detalle">
                <div>
                    <dt>Descripción</dt>
                    <dd id="fjDetalleDescripcion"></dd>
                </div>
                <div>
                    <dt>Unidad de medida</dt>
                    <dd id="fjDetalleUnidad"></dd>
                </div>
            </dl>

            <div class="fj-modal-actions">
                <button type="button" class="fj-btn fj-btn-primary" data-fj-modal-close>Cerrar</button>
            </div>
        </div>
    </div>
</div>