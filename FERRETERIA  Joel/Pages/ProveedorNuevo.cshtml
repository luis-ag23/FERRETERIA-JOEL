@page
@model FERRETERIA__Joel.Pages.ProveedorNuevoModel
@{
    ViewData["Title"] = "Nuevo Proveedor";
    ViewData["ActiveMenu"] = "Proveedores";
}
@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Catálogo</p>
        <h1>Nuevo Proveedor</h1>
        <p class="fj-page-sub">Registra un nuevo proveedor para el catálogo.</p>
    </section>

    @if (Model.Errores.Any())
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            <div>
                <strong>No se pudo guardar:</strong>
                <ul class="fj-alert-lista">
                    @foreach (var error in Model.Errores)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        </div>
    }

    <form method="post" class="fj-card fj-form" novalidate>
        <div class="fj-form-grid">
            <div class="fj-form-field @(Model.ErroresCampo.ContainsKey("RazonSocial") ? "fj-form-field-error" : "")">
                <label class="fj-form-label" asp-for="Proveedor.RazonSocial">Razón Social</label>
                <input class="fj-input" asp-for="Proveedor.RazonSocial" placeholder="Ingrese razón social" required maxlength="150" data-fj-regex="^\p{L}[\p{L}\s.,'\-&()]*$" data-fj-msj="La razón social solo admite letras y espacios (sin números ni caracteres especiales)." />
                @if (Model.ErroresCampo.TryGetValue("RazonSocial", out var errorRazonSocial))
                {
                    <p class="fj-form-error" role="alert">@errorRazonSocial</p>
                }
            </div>

            <div class="fj-form-field @(Model.ErroresCampo.ContainsKey("NombreComercial") ? "fj-form-field-error" : "")">
                <label class="fj-form-label" asp-for="Proveedor.NombreComercial">Nombre Comercial</label>
                <input class="fj-input" asp-for="Proveedor.NombreComercial" placeholder="Ingrese nombre comercial" required maxlength="150" data-fj-regex="^\p{L}[\p{L}\s.,'\-&()]*$" data-fj-msj="El nombre comercial solo admite letras y espacios (sin números ni caracteres especiales)." />
                @if (Model.ErroresCampo.TryGetValue("NombreComercial", out var errorNombreComercial))
                {
                    <p class="fj-form-error" role="alert">@errorNombreComercial</p>
                }
            </div>

            <div class="fj-form-field @(Model.ErroresCampo.ContainsKey("NombreContacto") ? "fj-form-field-error" : "")">
                <label class="fj-form-label" asp-for="Proveedor.NombreContacto">Nombre Contacto</label>
                <input class="fj-input" asp-for="Proveedor.NombreContacto" placeholder="Ingrese nombre del contacto" required maxlength="150" data-fj-regex="^\p{L}[\p{L}\s.,'\-&()]*$" data-fj-msj="El nombre del contacto solo admite letras y espacios (sin números ni caracteres especiales)." />
                @if (Model.ErroresCampo.TryGetValue("NombreContacto", out var errorNombreContacto))
                {
                    <p class="fj-form-error" role="alert">@errorNombreContacto</p>
                }
            </div>

            <div class="fj-form-field @(Model.ErroresCampo.ContainsKey("Telefono") ? "fj-form-field-error" : "")">
                <label class="fj-form-label" asp-for="Proveedor.Telefono">Teléfono</label>
                <input class="fj-input" asp-for="Proveedor.Telefono" type="tel" placeholder="Ej: 71234567" required maxlength="8" pattern="[5-8][0-9]{7}" data-fj-regex="^[5-8][0-9]{7}$" data-fj-msj="El teléfono debe tener 8 dígitos y comenzar con 5, 6, 7 u 8." />
                @if (Model.ErroresCampo.TryGetValue("Telefono", out var errorTelefono))
                {
                    <p class="fj-form-error" role="alert">@errorTelefono</p>
                }
            </div>

            <div class="fj-form-field @(Model.ErroresCampo.ContainsKey("CorreoElectronico") ? "fj-form-field-error" : "")">
                <label class="fj-form-label" asp-for="Proveedor.CorreoElectronico">Correo Electrónico</label>
                <input class="fj-input" asp-for="Proveedor.CorreoElectronico" type="email" placeholder="correo@ejemplo.com" maxlength="254" pattern="(?=.{6,64}@@)[A-Za-z0-9!#$%&amp;'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&amp;'*+/=?^_`{|}~-]+)*@@[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\.[A-Za-z]{2,24}" />
                @if (Model.ErroresCampo.TryGetValue("CorreoElectronico", out var errorCorreo))
                {
                    <p class="fj-form-error" role="alert">@errorCorreo</p>
                }
            </div>

            <div class="fj-form-field fj-form-field--full @(Model.ErroresCampo.ContainsKey("IdEmpleadoResponsable") ? "fj-form-field-error" : "")">
                <label class="fj-form-label" asp-for="Proveedor.IdEmpleadoResponsable">Empleado responsable</label>
                <select class="fj-input fj-select" asp-for="Proveedor.IdEmpleadoResponsable" required>
                    <option value="">-- Seleccione --</option>
                    @foreach (var empleado in Model.Empleados)
                    {
                        <option value="@empleado.IdEmpleado">@empleado.Nombre</option>
                    }
                </select>
                @if (Model.ErroresCampo.TryGetValue("IdEmpleadoResponsable", out var errorEmpleado))
                {
                    <p class="fj-form-error" role="alert">@errorEmpleado</p>
                }
            </div>

            <div class="fj-form-field fj-form-field--full">
                <label class="fj-form-label" asp-for="Proveedor.Direccion">Dirección</label>
                <textarea class="fj-input fj-input-area" asp-for="Proveedor.Direccion" rows="3" maxlength="255" placeholder="Ingrese dirección"></textarea>
            </div>
        </div>

        <div class="fj-form-actions">
            <a asp-page="Proveedores" class="fj-btn fj-btn-ghost">Cancelar</a>
            <button type="submit" class="fj-btn fj-btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg>
                Guardar
            </button>
        </div>
    </form>

</div>