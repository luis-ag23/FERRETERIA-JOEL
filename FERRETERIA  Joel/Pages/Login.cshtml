@page
@model FERRETERIA__Joel.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["ActiveMenu"] = "Login";
}
@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Cuenta · Empleado</p>
        <h1>Iniciar sesión</h1>
        <p class="fj-page-sub">Acceso al panel interno. Ingrese con su correo y contraseña.</p>
    </section>

    @if (Model.Mensaje != null)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            <div>
                <span>@Model.Mensaje</span>
            </div>
        </div>
    }

    <form method="post" class="fj-card fj-form" novalidate>
        <div class="fj-form-grid">
            <div class="fj-form-field fj-form-field--full">
                <label class="fj-form-label" asp-for="Solicitud.CorreoElectronico">Correo electrónico</label>
                <input class="fj-input" asp-for="Solicitud.CorreoElectronico" type="email" maxlength="150" placeholder="correo@ejemplo.com" autocomplete="username" required />
            </div>

            <div class="fj-form-field fj-form-field--full">
                <label class="fj-form-label" asp-for="Solicitud.Contrasena">Contraseña</label>
                <div class="fj-password">
                    <input class="fj-input" asp-for="Solicitud.Contrasena" type="password" maxlength="64" placeholder="Su contraseña" autocomplete="current-password" required />
                    <button type="button" class="fj-password-toggle" data-fj-toggle-password aria-label="Mostrar contraseña" aria-pressed="false" tabindex="-1">
                        <svg class="fj-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                        <svg class="fj-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="fj-form-actions">
            <a asp-page="/Index" class="fj-btn fj-btn-ghost">Cancelar</a>
            <button type="submit" class="fj-btn fj-btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" /></svg>
                Ingresar
            </button>
        </div>
    </form>

</div>
