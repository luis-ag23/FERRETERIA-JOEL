@page
@model FERRETERIA__Joel.Pages.PersonalModel
@using FERRETERIA__Joel.Dominio.Constantes
@{
    ViewData["Title"] = "Personal";
    ViewData["ActiveMenu"] = "Registro";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Personal</p>
        <h1>Personal</h1>
        <p class="fj-page-sub">Administración de las cuentas de los empleados.</p>
    </section>

    @if (TempData["Mensaje"] != null)
    {
        <div class="fj-alert fj-alert-success" role="status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            <span>@TempData["MensajeError"]</span>
        </div>
    }

    <section class="fj-toolbar fj-toolbar-simple">
        <p class="fj-toolbar-count">
            <strong>@Model.Personal.Count</strong>
            @(Model.Personal.Count == 1 ? "empleado registrado" : "empleados registrados")
        </p>
    </section>

    <section class="fj-card fj-table-card" aria-label="Listado de personal">
        <div class="fj-table-wrap fj-table-wrap-scroll">
            <table class="fj-table fj-table-personal">
                <thead>
                    <tr>
                        <th scope="col">Empleado</th>
                        <th scope="col">Rol</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Alta</th>
                        <th scope="col" class="fj-td-estado">Estado</th>
                        <th scope="col" class="fj-td-acciones">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Personal.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="fj-table-vacio">
                                <div class="fj-empty">
                                    <span class="fj-empty-ico" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                    </span>
                                    <p>Sin personal registrado</p>
                                    <span>Cuando existan empleados en el sistema, aparecerán aquí.</span>
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var empleado in Model.Personal)
                    {
                        <tr>
                            <td>
                                <span class="fj-nombre">@empleado.Nombre @empleado.Apellido</span>
                                <span class="fj-nombre-sub">@empleado.Telefono</span>
                            </td>

                            <td class="fj-td-secundario">
                                @empleado.Rol
                            </td>

                            <td class="fj-td-secundario">
                                @if (!string.IsNullOrEmpty(empleado.CorreoElectronico))
                                {
                                    <span title="@empleado.CorreoElectronico">
                                        @empleado.CorreoElectronico
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="fj-td-secundario">
                                @empleado.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>

                            <td class="fj-td-estado">
                                @switch (empleado.Estado)
                                {
                                    case EstadoEmpleado.Activo:
                                        <span class="fj-pill" style="--pill: var(--success);">Activo</span>
                                        break;
                                    case EstadoEmpleado.Inactivo:
                                        <span class="fj-pill" style="--pill: var(--texto-ter);">Inactivo</span>
                                        break;
                                    default:
                                        <span class="fj-pill" style="--pill: var(--warning);">Pendiente</span>
                                        break;
                                }
                            </td>

                            <td class="fj-td-acciones">
                                <div class="fj-acciones">
                                    @if (empleado.Estado == EstadoEmpleado.Inactivo)
                                    {
                                        <form method="post"
                                              asp-page-handler="Reactivar"
                                              class="fj-inline-form"
                                              data-fj-confirm="¿Desea reactivar la cuenta de '@empleado.Nombre @empleado.Apellido'? Se le enviará un nuevo enlace de activación.">
                                            <input type="hidden" name="idEmpleado" value="@empleado.IdEmpleado" />
                                            <button type="submit" class="fj-btn fj-btn-primary fj-btn-sm" title="Reactivar cuenta">
                                                Reactivar
                                            </button>
                                        </form>
                                    }
                                    else if (empleado.Estado == EstadoEmpleado.PendienteActivacion)
                                    {
                                        <form method="post"
                                              asp-page-handler="Reenviar"
                                              class="fj-inline-form"
                                              data-fj-confirm="¿Está seguro de reenviar el enlace de activación a '@empleado.Nombre @empleado.Apellido'? Se generará un enlace nuevo y el anterior dejará de funcionar.">
                                            <input type="hidden" name="idEmpleado" value="@empleado.IdEmpleado" />
                                            <button type="submit" class="fj-btn fj-btn-primary fj-btn-sm" title="Reenviar enlace de activación">
                                                Reenviar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post"
                                              asp-page-handler="Baja"
                                              class="fj-inline-form"
                                              data-fj-confirm="¿Desea dar de baja la cuenta de '@empleado.Nombre @empleado.Apellido'?">
                                            <input type="hidden" name="idEmpleado" value="@empleado.IdEmpleado" />
                                            <button type="submit" class="fj-btn fj-btn-danger fj-btn-icon" title="Dar de baja" aria-label="Dar de baja">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.Pendientes.Any())
    {
        <section class="fj-card fj-table-card" aria-label="Pendientes de activación" style="margin-top:1.5rem;">
            <div class="fj-form-field" style="gap:.35rem;padding:1rem 1rem 0;">
                <h2 style="margin:0;font-size:1.15rem;">Pendientes de activación</h2>
                <p class="fj-form-hint" style="margin:0;">
                    Empleados que recibieron el enlace pero aún no lo usaron. Si el enlace venció (10 minutos),
                    use <strong>Reenviar</strong> para generar uno nuevo.
                </p>
            </div>

            <div class="fj-table-wrap fj-table-wrap-scroll">
                <table class="fj-table fj-table-personal">
                    <thead>
                        <tr>
                            <th scope="col">Empleado</th>
                            <th scope="col">Rol</th>
                            <th scope="col">Correo</th>
                            <th scope="col">Enlace vence</th>
                            <th scope="col" class="fj-td-acciones">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var pendiente in Model.Pendientes)
                        {
                            var vencido = pendiente.TokenExpira is null || pendiente.TokenExpira < DateTime.Now;
                            <tr>
                                <td>
                                    <span class="fj-nombre">@pendiente.Nombre @pendiente.Apellido</span>
                                    <span class="fj-nombre-sub">@pendiente.Telefono</span>
                                </td>

                                <td class="fj-td-secundario">@pendiente.Rol</td>

                                <td class="fj-td-secundario">
                                    @if (!string.IsNullOrEmpty(pendiente.CorreoElectronico))
                                    {
                                        <span title="@pendiente.CorreoElectronico">@pendiente.CorreoElectronico</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>

                                <td class="fj-td-secundario">
                                    @if (vencido)
                                    {
                                        <span class="fj-pill" style="--pill: var(--warning);">Vencido</span>
                                    }
                                    else
                                    {
                                        <span>@pendiente.TokenExpira?.ToString("HH:mm:ss")</span>
                                    }
                                </td>

                                <td class="fj-td-acciones">
                                    <form method="post"
                                          asp-page-handler="Reenviar"
                                          class="fj-inline-form"
                                          data-fj-confirm="¿Está seguro de reenviar el enlace de activación a '@pendiente.Nombre @pendiente.Apellido'? Se generará un enlace nuevo y el anterior dejará de funcionar.">
                                        <input type="hidden" name="idEmpleado" value="@pendiente.IdEmpleado" />
                                        <button type="submit" class="fj-btn fj-btn-primary fj-btn-sm" title="Reenviar enlace de activación">
                                            Reenviar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

</div>

<partial name="_ConfirmModal" />
