@page
@model FERRETERIA__Joel.Pages.ActivarCuentaModel
@{
    ViewData["Title"] = "Activar cuenta";
    ViewData["ActiveMenu"] = "";
}
@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Cuenta · Activación</p>
        <h1>Activar cuenta</h1>
        <p class="fj-page-sub">Defina la contraseña con la que ingresará al panel interno.</p>
    </section>

    @if (Model.Activada)
    {
        <div class="fj-alert fj-alert-success" role="status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            <div>
                <span>Cuenta activada con éxito@(string.IsNullOrWhiteSpace(Model.NombreEmpleado) ? "" : $", {Model.NombreEmpleado}"). Ya puede iniciar sesión.</span>
                <a asp-page="/Login">Iniciar sesión</a>
            </div>
        </div>
    }
    else if (!Model.TokenValido)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
            <div>
                <span>@(Model.Mensaje ?? "El enlace de activación no es válido.")</span>
            </div>
        </div>

        <div class="fj-form-actions">
            <a asp-page="/Login" class="fj-btn fj-btn-ghost">Ir a iniciar sesión</a>
        </div>
    }
    else
    {
        <form method="post" class="fj-card fj-form" novalidate>
            <input type="hidden" asp-for="Solicitud.Token" />

            <p class="fj-page-sub">Hola <strong>@Model.NombreEmpleado</strong>. Elija una contraseña segura.</p>

            <div class="fj-form-grid">
                <div class="fj-form-field fj-form-field--full @(Model.ErroresCampo.ContainsKey("Contrasena") ? "fj-form-field-error" : "")">
                    <label class="fj-form-label" asp-for="Solicitud.Contrasena">Contraseña</label>
                    <div class="fj-password">
                        <input class="fj-input" asp-for="Solicitud.Contrasena" type="password" maxlength="64" placeholder="Mínimo 8 caracteres" autocomplete="new-password" required />
                        <button type="button" class="fj-password-toggle" data-fj-toggle-password aria-label="Mostrar contraseña" aria-pressed="false" tabindex="-1">
                            <svg class="fj-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="fj-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    <span class="fj-form-hint">Debe incluir mayúscula, minúscula, número y símbolo.</span>
                    @if (Model.ErroresCampo.TryGetValue("Contrasena", out var errorContrasena))
                    {
                        <p class="fj-form-error" role="alert">@errorContrasena</p>
                    }
                </div>

                <div class="fj-form-field fj-form-field--full @(Model.ErroresCampo.ContainsKey("ConfirmarContrasena") ? "fj-form-field-error" : "")">
                    <label class="fj-form-label" asp-for="Solicitud.ConfirmarContrasena">Confirmar contraseña</label>
                    <div class="fj-password">
                        <input class="fj-input" asp-for="Solicitud.ConfirmarContrasena" type="password" maxlength="64" placeholder="Repita la contraseña" autocomplete="new-password" required />
                        <button type="button" class="fj-password-toggle" data-fj-toggle-password aria-label="Mostrar contraseña" aria-pressed="false" tabindex="-1">
                            <svg class="fj-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            <svg class="fj-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                        </button>
                    </div>
                    @if (Model.ErroresCampo.TryGetValue("ConfirmarContrasena", out var errorConfirmacion))
                    {
                        <p class="fj-form-error" role="alert">@errorConfirmacion</p>
                    }
                </div>
            </div>

            <div class="fj-form-actions">
                <a asp-page="/Login" class="fj-btn fj-btn-ghost">Cancelar</a>
                <button type="submit" class="fj-btn fj-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg>
                    Activar cuenta
                </button>
            </div>
        </form>
    }

</div>
